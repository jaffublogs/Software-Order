# SMTP / Email Configuration (Gmail App Password or Custom SMTP)
SMTP_USER=jaffuvlogs@gmail.com
SMTP_PASS=your_gmail_app_password
# Optional custom sender name/email (default: "Imran Softkart" <SMTP_USER>)
SMTP_FROM="Imran Softkart" <jaffuvlogs@gmail.com>
# Optional custom SMTP host & port (default: smtp.gmail.com:465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Admin Notification Recipient Email (default: same as SMTP_USER)
ADMIN_EMAIL=jaffuvlogs@gmail.com

# Webhook Integrations
GOOGLE_SHEET_WEBHOOK=https://script.google.com/macros/s/your_script_id/exec

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Frontend (If backend is deployed on Render and frontend on Vercel)
# VITE_BACKEND_URL=https://your-backend.onrender.com
